{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup .claude/scripts/auto-commit-daemon.sh >> .claude/auto-commit-daemon.log 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/auto-commit-daemon.sh --stop >> .claude/auto-commit-daemon.log 2>&1",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Bash(pip3 install:*)",
      "Bash(ls:*)",
      "mcp__playwright__browser_navigate",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git diff-tree:*)",
      "Bash(git -c http.postBuffer=524288000 push)",
      "Bash(sort:*)",
      "Bash(chmod +x:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(rm:*)"
    ]
  }
}
