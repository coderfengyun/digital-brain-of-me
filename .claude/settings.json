{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup .claude/scripts/auto-commit-daemon.sh > /dev/null 2>&1 &",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/.auto-commit-daemon.pid ]; then kill $(cat .claude/.auto-commit-daemon.pid) 2>/dev/null; rm -f .claude/.auto-commit-daemon.pid; fi && if [ -n \"$(git status --porcelain)\" ]; then git add -A && git commit -m \"Auto-commit on session end\" && git push; fi",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Bash(pip3 install:*)",
      "Bash(ls:*)",
      "mcp__playwright__browser_navigate",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git diff-tree:*)",
      "Bash(git -c http.postBuffer=524288000 push)",
      "Bash(sort:*)",
      "Bash(chmod +x:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(rm:*)"
    ]
  }
}
